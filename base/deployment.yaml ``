apiVersion: apps/v1
kind: Deployment

metadata:
  name: poc-20-app

spec:
  replicas: 2

  selector:
    matchLabels:
      app: poc-20-app

  template:
    metadata:
      labels:
        app: poc-20-app

    spec:
      containers:
      - name: poc-20-app
        image: bhanusrirani/poc-20-app:latest
        ports:
        - containerPort: 5000
